{
  "name": "clear",
  "version": "0.1.0",
  "private": true,
  "description": "CLEAR: calmer, clearer web pages for neurodivergent users.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node --test tests/*.test.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:network": "node scripts/check-no-network.mjs",
    "check": "npm run compile && npm test && npm run build && npm run check:manifest && npm run check:network"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "engines": {
    "node": ">=23.6"
  }
}
